{
  "name": "guia-do-consultor-faktory-flow",
  "private": true,
  "type": "module",
  "description": "Guia do Consultor e Apostila do Faktory Flow — site estático com login, perfis de acesso e edição dos módulos (Vercel + Neon PostgreSQL).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "migrar": "node --env-file-if-exists=.env scripts/migrar.mjs",
    "vercel-build": "node scripts/migrar.mjs",
    "checklists": "node scripts/gerar-checklists-estagiarios.mjs && node scripts/validar-checklists.mjs",
    "checklists:lacunas": "node scripts/lacunas-checklists.mjs",
    "testar:checklists-api": "node scripts/testar-checklists-api.mjs",
    "testar:seguranca": "node scripts/testar-seguranca.mjs",
    "testar:visibilidade": "node scripts/testar-visibilidade.mjs",
    "testar": "node --test \"scripts/testes/*.test.mjs\"",
    "base:gerar": "node scripts/gerar-base-conhecimento.mjs",
    "base:verificar": "node scripts/gerar-base-conhecimento.mjs --verificar",
    "exemplos:conteudo": "node scripts/gerar-exemplos-conteudo.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "pg": "^8.23.0"
  }
}
